modules = ["nodejs-20", "python-3.11"]

[agent]
expertMode = true
integrations = ["stripe:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo Web"

[[workflows.workflow]]
name = "Expo Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run web"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
DEV_BYPASS_PAYWALL = "true"

[userenv.shared]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "scripts/build-web.sh"]
publicDir = "dist"
run = ["node", "proxy.js"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
