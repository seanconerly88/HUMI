modules = ["nodejs-20", "python-3.11"]

[agent]
expertMode = true
integrations = ["stripe:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo Web"

[[workflows.workflow]]
name = "Expo Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run web"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
DEV_BYPASS_PAYWALL = "true"

[userenv.shared]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "VERSION=$(date +%Y%m%d%H%M%S) && npx expo export --platform web --clear && cp public/manifest.json dist/ && cp public/version.json dist/ && sed \"s/BUILD_VERSION/$VERSION/g\" public/service-worker.js > dist/service-worker.js && sed -i 's|</head>|<script>if(\"serviceWorker\"in navigator){navigator.serviceWorker.register(\"/service-worker.js\",{updateViaCache:\"none\"}).then(function(r){r.update();console.log(\"SW registered\")});navigator.serviceWorker.addEventListener(\"controllerchange\",function(){location.reload(true)})}</script><style>html,body{width:100%;height:100%;min-height:100vh;min-height:-webkit-fill-available;margin:0;padding:0;overflow:hidden;background-color:#ffffff}#root{width:100%;height:100%;min-height:100vh;min-height:-webkit-fill-available;display:flex;flex-direction:column;background-color:#ffffff}#root>div,#root>div>div,[data-expo-root]{flex:1;display:flex;flex-direction:column;width:100%;height:100%;min-height:0}</style></head>|' dist/index.html && cp dist/index.html dist/200.html"]
publicDir = "dist"
run = ["node", "proxy.js"]
